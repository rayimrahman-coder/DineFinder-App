<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/arrivalOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#990B1210"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/discovery_sheet_background"
            android:elevation="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingTop="24dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/discovery_status_background"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/ar_arrival_success"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="You've arrived!"
                android:textColor="@color/ar_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/arrivalRestaurantName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/ar_text_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/viewRestaurantButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/ar_button_primary"
                android:text="View Restaurant"
                android:textAllCaps="false"
                android:textColor="@color/ar_on_button_primary"
                android:textStyle="bold" />

            <Button
                android:id="@+id/finishNavigationButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/ar_button_secondary"
                android:text="Finish Navigation"
                android:textAllCaps="false"
                android:textColor="@color/ar_text_button" />
        </LinearLayout>
    </FrameLayout>
