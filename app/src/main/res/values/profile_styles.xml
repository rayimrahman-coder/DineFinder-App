<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DineFinder.Profile" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/profile_accent</item>
        <item name="colorPrimaryVariant">@color/profile_accent</item>
        <item name="colorOnPrimary">@color/profile_on_accent</item>
        <item name="colorSecondary">@color/profile_accent</item>
        <item name="colorSecondaryVariant">@color/profile_accent</item>
        <item name="colorOnSecondary">@color/profile_on_accent</item>
        <item name="colorSurface">@color/profile_surface</item>
        <item name="colorOnSurface">@color/profile_ink</item>
        <item name="colorOnBackground">@color/profile_ink</item>
        <item name="android:colorBackground">@color/profile_background</item>
        <item name="android:windowBackground">@color/profile_background</item>
        <item name="android:textColorPrimary">@color/profile_ink</item>
        <item name="android:textColorSecondary">@color/profile_muted</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:statusBarColor">@color/profile_background</item>
        <item name="android:navigationBarColor">@color/profile_surface</item>
        <item name="android:windowLightStatusBar">@bool/profile_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/profile_light_system_bars</item>
        <item name="materialButtonStyle">@style/Widget.DineFinder.Profile.Button</item>
        <item name="materialCardViewStyle">@style/Widget.DineFinder.Profile.Card</item>
    </style>

    <style name="Widget.DineFinder.Profile.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/profile_surface</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/profile_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.DineFinder.Profile.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/profile_accent</item>
        <item name="android:textColor">@color/profile_on_accent</item>
        <item name="iconTint">@color/profile_on_accent</item>
        <item name="cornerRadius">18dp</item>
        <item name="iconPadding">10dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.DineFinder.Profile.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@color/profile_surface</item>
        <item name="android:textColor">@color/profile_ink</item>
        <item name="iconTint">@color/profile_accent</item>
        <item name="strokeColor">@color/profile_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="iconPadding">10dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

</resources>
